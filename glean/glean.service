[Unit]
Description=GLEAN - Grammarly Live Endpoint Analysis (mitmproxy addon)
After=network-online.target
Wants=network-online.target
# If you hook this into the existing transparent-proxy unit instead of
# running standalone, add: After=transparent-proxy.service
#                          BindsTo=transparent-proxy.service

[Service]
Type=simple
User=kaiya
WorkingDirectory=/home/kaiya/glean
ExecStart=/usr/local/bin/mitmdump -s /home/kaiya/glean/glean/addon.py \
    --set glean_db=/home/kaiya/glean/data/glean.db \
    --set glean_label=always-on \
    --set glean_baseline=all \
    --listen-port 8080

# This is what actually fixes the mitmweb-dies-on-SSH-drop issue:
# systemd restarts the process; GLEAN's own durability comes from
# incremental per-flow SQLite writes (see db.py), not from this unit.
Restart=on-failure
RestartSec=3

# On a clean `systemctl stop`, mitmdump's addon.done() hook runs and
# writes sessions.ended_at (a summary pass, not a data flush -- see
# db.py / cli.py docstrings).
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
